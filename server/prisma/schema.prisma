// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// -------------------- Enums --------------------

// Trip Roles
enum TripRole {
  OWNER
  MEMBER
}

// Trip Invitation Statuses
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Reservation Types
enum ReservationType {
  FLIGHT
  HOTEL
  RENTAL_CAR
  RESTAURANT
  ATTRACTION
  OTHER
}

// Notification Types
enum NotificationType {
  TRIP_INVITATION
  MEMBER_JOINED
  ACTIVITY_CREATED
  ACTIVITY_VOTED
  ITINERARY_UPDATED
  RESERVATION_ADDED
  EXPENSE_ADDED
  COMMENT_ADDED
}

// -------------------- Tables --------------------

// -------------------- Auth Tables --------------------

// User Table
//   - Mirror of the Supabase Auth user
//   - Supabase owns identity: password, OAuth, email confirmation, token refreshes.
//     However, it does not own anything trip-related.
//     We keep this thin copy so that every other table can hold a real foreign key to a user,
//     and so our Prisma queries can `include` user details without another trip to Supabase
//
//   - NOTE: `id` is NOT generated here, but it is the `sub` claim from the Supabase JWT;
//           this way both systems associate the same id with the same user
model User {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // One to many relationships
  tripsCreated           Trip[]
  memberships            TripMember[]
  invitationsSent        TripInvitation[]
  activitiesCreated      Activity[]
  activityVotes          ActivityVote[]
  reservationsCreated    Reservation[]
  itineraryEventsCreated ItineraryEvent[]
  expensesCreated        Expense[]            @relation("ExpenseCreatedBy")
  expensesPaid           Expense[]            @relation("ExpensePaidBy")
  expenseParticipations  ExpenseParticipant[]
  comments               Comment[]
  fileAttachments        FileAttachment[]
  notifications          Notification[]

  @@map("users")
}

// -------------------- Trip Tables --------------------

// Trip Table
//   - `createdById` is provenance only; it records who made the trip and never
//     changes. Permissions come from TripMember.role, so transferring ownership
//     is a role change on one row, not a write to two tables that could half-fail.
//
//   - Trip status (Upcoming / Active / Completed) is DERIVED from startDate and
//     endDate at read time. Storing it would require a job to keep it accurate.
model Trip {
  id          String   @id @default(uuid(7)) @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  name        String
  description String?
  destination String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict: a user who created trips cannot be hard-deleted out from under
  // them. Deactivate the account instead.
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // One to many relationships
  members         TripMember[]
  invitations     TripInvitation[]
  activities      Activity[]
  reservations    Reservation[]
  itineraryEvents ItineraryEvent[]
  expenses        Expense[]
  comments        Comment[]
  fileAttachments FileAttachment[]
  notifications   Notification[]

  @@index([createdById])
  @@index([startDate])
  @@map("trips")
}

// TripMember Table
//   - Resolves the many-to-many between users and trips, and carries the role.
//
//   - The trip creator MUST get a row here with role OWNER; create both in one
//     transaction so an ownerless trip is impossible.
model TripMember {
  id       String   @id @default(uuid(7)) @db.Uuid
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId]) // "which trips am I in?" - the dashboard's main query
  @@map("trip_members")
}

// TripInvitation Table
//   - Invitations are addressed to an EMAIL, not a user, because the invitee may
//     not have an account yet. Accepting creates the TripMember row.
//
//   - No @@unique([tripId, email]) - it would block re-inviting someone who
//     declined.
model TripInvitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  tripId      String           @map("trip_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  email       String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([invitedById])
  @@index([email, status]) // "my pending invitations" on the dashboard
  @@map("trip_invitations")
}

// -------------------- Trip Planning Tables --------------------

// Activity Table
//   - An activity is a POSSIBILITY the group may vote on. It becomes a scheduled
//     thing only when an ItineraryEvent references it.
model Activity {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  createdById        String    @map("created_by_id") @db.Uuid
  name               String
  description        String?
  suggestedDateTime  DateTime? @map("suggested_date_time") @db.Timestamptz(3)
  locationName       String?   @map("location_name")
  locationAddress    String?   @map("location_address")
  latitude           Float?
  longitude          Float?
  estimatedCostCents Int?      @map("estimated_cost_cents")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // One to many relationships
  votes           ActivityVote[]
  itineraryEvents ItineraryEvent[]
  expenses        Expense[]
  comments        Comment[]
  fileAttachments FileAttachment[]

  @@index([tripId])
  @@index([createdById])
  @@map("activities")
}

// ActivityVote Table
//   - Upvote-only: the presence of a row IS the vote. There is no `value` column,
//     so un-voting is a delete. The unique constraint makes double-voting
//     impossible at the database level rather than relying on application checks.
model ActivityVote {
  id         String   @id @default(uuid(7)) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Foreign key relationships
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
  @@map("activity_votes")
}

// Reservation Table
//   -  A reservation is CONFIRMED information; something already booked.
model Reservation {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tripId             String          @map("trip_id") @db.Uuid
  createdById        String          @map("created_by_id") @db.Uuid
  type               ReservationType
  name               String
  confirmationNumber String?         @map("confirmation_number")
  startDateTime      DateTime?       @map("start_date_time") @db.Timestamptz(3)
  endDateTime        DateTime?       @map("end_date_time") @db.Timestamptz(3)
  locationName       String?         @map("location_name")
  locationAddress    String?         @map("location_address")
  latitude           Float?
  longitude          Float?
  costCents          Int?            @map("cost_cents")
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // One to many relationships
  itineraryEvents ItineraryEvent[]
  expenses        Expense[]
  comments        Comment[]
  fileAttachments FileAttachment[]

  @@index([tripId, startDateTime])
  @@index([createdById])
  @@map("reservations")
}

// ItineraryEvent Table
//   - The actual SCHEDULED plan. May originate from an Activity, from a
//     Reservation, or from neither (a standalone event like "meet in the lobby").
//
//   - Both source FKs use SetNull: deleting an activity must not delete the
//     scheduled event that came from it.
model ItineraryEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  title           String
  description     String?
  startDateTime   DateTime  @map("start_date_time") @db.Timestamptz(3)
  endDateTime     DateTime? @map("end_date_time") @db.Timestamptz(3)
  locationName    String?   @map("location_name")
  locationAddress String?   @map("location_address")
  latitude        Float?
  longitude       Float?
  activityId      String?   @map("activity_id") @db.Uuid
  reservationId   String?   @map("reservation_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  activity    Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  // One to many relationships
  comments        Comment[]
  fileAttachments FileAttachment[]

  @@index([tripId, startDateTime]) // the itinerary view, ordered by day
  @@index([createdById])
  @@index([activityId])
  @@index([reservationId])
  @@map("itinerary_events")
}

// -------------------- Financial Tables --------------------

// Expense Table
//   - All money is integer cents. Int holds up to ~$21.4 million, which is well
//     past any plausible trip.
//
//   - INVARIANT the database cannot enforce: the sum of this expense's
//     ExpenseParticipant.shareCents must equal amountCents. Enforce it in one
//     service function and cover it with a unit test.
model Expense {
  id            String   @id @default(uuid(7)) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  paidById      String   @map("paid_by_id") @db.Uuid
  title         String
  description   String?
  amountCents   Int      @map("amount_cents")
  expenseDate   DateTime @map("expense_date") @db.Date
  activityId    String?  @map("activity_id") @db.Uuid
  reservationId String?  @map("reservation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity    Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  // TWO relations to User, so Prisma requires explicit names on both sides.
  // Without these the schema will not validate.
  createdBy   User         @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidBy      User         @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  // One to many relationships
  participants    ExpenseParticipant[]
  comments        Comment[]
  fileAttachments FileAttachment[]

  @@index([tripId, expenseDate])
  @@index([paidById])
  @@index([createdById])
  @@index([activityId])
  @@index([reservationId])
  @@map("expenses")
}

// ExpenseParticipant Table
//   - One row per participating member. Lets an expense be split across any
//     subset of the trip, with uneven shares when needed.
//
//   - No Settlement table for MVP; balances are computed on read from expenses
//     and participants.
model ExpenseParticipant {
  id         String @id @default(uuid(7)) @db.Uuid
  expenseId  String @map("expense_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  shareCents Int    @map("share_cents")

  // Foreign key relationships
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  // Restrict: removing a user must not silently rewrite other people's
  // balances. Remove them from the expense explicitly first.
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId]) // "what do I owe across this trip?"
  @@map("expense_participants")
}

// -------------------- Contextual Tables --------------------

// Comment Table
//   - Contextual comments. Exactly one of the four parent FKs should be set
//
//   - `tripId` is required even though it is derivable from the parent. That
//      denormalization makes trip-scoped queries and permission checks single-table
//      lookups. It CAN drift, so write comments through one service function.
model Comment {
  id               String   @id @default(uuid(7)) @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  activityId       String?  @map("activity_id") @db.Uuid
  reservationId    String?  @map("reservation_id") @db.Uuid
  expenseId        String?  @map("expense_id") @db.Uuid
  itineraryEventId String?  @map("itinerary_event_id") @db.Uuid
  content          String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  itineraryEvent ItineraryEvent? @relation(fields: [itineraryEventId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([userId])
  @@index([activityId])
  @@index([reservationId])
  @@index([expenseId])
  @@index([itineraryEventId])
  @@map("comments")
}

// FileAttachment Table
//   - File METADATA only. The bytes live in Supabase Storage at `storagePath`.
//
//   - WARNING: deleting this row does NOT delete the stored object. Whoever
//     implements uploads must delete from Storage in the same operation, or you
//     accumulate orphaned files nobody can see or clean up.
model FileAttachment {
  id               String   @id @default(uuid(7)) @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  uploadedById     String   @map("uploaded_by_id") @db.Uuid
  activityId       String?  @map("activity_id") @db.Uuid
  reservationId    String?  @map("reservation_id") @db.Uuid
  expenseId        String?  @map("expense_id") @db.Uuid
  itineraryEventId String?  @map("itinerary_event_id") @db.Uuid
  fileName         String   @map("file_name")
  /// Path inside the Storage bucket, NOT a public URL. Generate signed URLs
  /// at read time so access follows trip membership.
  storagePath      String   @map("storage_path")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Foreign key relationships
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  itineraryEvent ItineraryEvent? @relation(fields: [itineraryEventId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([uploadedById])
  @@index([activityId])
  @@index([reservationId])
  @@index([expenseId])
  @@index([itineraryEventId])
  @@map("file_attachments")
}

// Notification Table
//   - Application-level, optionally scoped to a trip.
//
//   - There is deliberately no FK to ActivityVote or any other triggering entity.
//     Notifications are produced by application logic; `tripId` plus a
//     client-side route is enough to deep-link.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tripId    String?          @map("trip_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Foreign key relationships
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt]) // unread badge + notification list
  @@index([tripId])
  @@map("notifications")
}
