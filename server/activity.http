@supabaseUrl = https://usivgxovisdhfqneffto.supabase.co
@publishableKey = sb_publishable_7lOB5WANGC3tMzzxh7Loqg_sNqEOuEE
@baseUrl = http://localhost:4000/api
@tripId = 01a16f29-4653-75cd-b7f9-f8778b234509
@activityId = 01a155b5-9516-7684-b1ab-2b030805acea

### Sign in as the test user
# @name signin
POST {{supabaseUrl}}/auth/v1/token?grant_type=password
apikey: {{publishableKey}}
Content-Type: application/json

{
  "email": "joshlaptop@example.com",
  "password": "test1234"
}

###
@token = {{signin.response.body.access_token}}

### List activities for a trip
GET {{baseUrl}}/trips/{{tripId}}/activities
Authorization: Bearer {{token}}

### Get details for one activity
GET {{baseUrl}}/trips/{{tripId}}/activities/{{activityId}}
Authorization: Bearer {{token}}

### Create an activity
# @name createActivity
POST {{baseUrl}}/trips/{{tripId}}/activities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Visit the museum",
  "description": "Explore the exhibits",
  "locationName": "City Museum",
  "estimatedCostCents": 2500
}

###
@newActivityId = {{createActivity.response.body.activity.id}}

### Update the newly created activity
PATCH {{baseUrl}}/trips/{{tripId}}/activities/{{newActivityId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Visit the museum in the afternoon",
  "estimatedCostCents": 3000
}

### Delete the newly created activity
DELETE {{baseUrl}}/trips/{{tripId}}/activities/{{newActivityId}}
Authorization: Bearer {{token}}
