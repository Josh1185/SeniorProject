###############################################################################
# FILE: expense.http
# DESCRIPTION: Manual request tests for the expense module. Run with the
#              VS Code REST Client extension (humao.rest-client).
#
#              Every request below has an expected status in its comment.
#              The PR is not ready until every one of them returns what its
#              comment says - including the ones that are supposed to fail.
#
#              Run them top to bottom. The sign-in at the top sets the token
#              that every later request uses; if you start in the middle you
#              will get a 401 and think something is broken.
#
# LAST UPDATED: 2026-10-18 - File Created (Josh Iehle)
###############################################################################

# -------------------- Variables --------------------
# Copy the Supabase values from your server/.env. Everything else you fill in
# after the first two requests below.

@baseUrl = http://localhost:4000/api
@supabaseUrl = https://usivgxovisdhfqneffto.supabase.co
@supabaseKey = sb_publishable_7lOB5WANGC3tMzzxh7Loqg_sNqEOuEE

@email = josh@abc.com
@password = test1234

# A trip you ARE a member of, and an expense on it.
@tripId = 01a1568d-45db-70de-9115-291ebacf0bc3
@expenseId = 00000000-0000-7000-8000-10000000aaaa

# A trip you are NOT a member of, and an expense that belongs to it.
# Get these from db:studio while signed in as a different account. These two
# are what make the scoping tests real - without them you are only testing
# the happy path.
@otherTripId = 00000000-0000-7000-8000-00000000aaaa
@otherTripExpenseId = 01a1451b-b31c-73af-969b-6e17f73db219

@memberId = 7e2391f1-fe94-4ca1-bcec-132efa02c34c
@outsiderId = 01a1451b-b2f8-75be-8b89-a649757dafd7


###############################################################################
# 0. SETUP
###############################################################################

### Sign in. Expect 200. Everything below depends on this.
# @name signIn
POST {{supabaseUrl}}/auth/v1/token?grant_type=password
apikey: {{supabaseKey}}
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
@token = {{signIn.response.body.access_token}}

### List your trips, to get a tripId. Expect 200.
GET {{baseUrl}}/trips
Authorization: Bearer {{token}}


###############################################################################
# 1. LIST - happy path
###############################################################################

### Expect 200 and { "expenses": [...] }.
# Each item: id, title, expenseDate, amountCents, paidBy { id, displayName },
# participantCount. Check amountCents is an INTEGER - 6200, never 62.00.
GET {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}

### Default order. Expect 200, newest expenseDate first.
# This is the opposite of the trip list, which is soonest-first. Confirm it
# by eye before moving on - a wrong default is invisible until someone
# complains the list "looks random".
GET {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}

### Search. Expect 200 and only expenses whose title contains the term.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=gas
Authorization: Bearer {{token}}

### Search is case-insensitive. Expect 200 and the SAME rows as the request above.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=GAS
Authorization: Bearer {{token}}

### Partial match. Expect 200 - "ga" must match "Gas".
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=ga
Authorization: Bearer {{token}}

### Search matching nothing. Expect 200 and { "expenses": [] }.
# An empty list, NOT a 404. Nothing was missing; nothing matched.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=zzzznotathing
Authorization: Bearer {{token}}

### Sort by title ascending. Expect 200, alphabetical.
GET {{baseUrl}}/trips/{{tripId}}/expenses?sort=title&order=asc
Authorization: Bearer {{token}}

### Sort by creation order. Expect 200.
GET {{baseUrl}}/trips/{{tripId}}/expenses?sort=createdAt&order=asc
Authorization: Bearer {{token}}

### Search and sort together. Expect 200.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=a&sort=title&order=desc
Authorization: Bearer {{token}}


###############################################################################
# 2. LIST - empty and malformed query params
#
# These are the ones that break in the browser rather than in testing: a
# <select> reset to its placeholder sends an empty param, and if the schema
# rejects it the whole list 422s the moment a user clears a filter.
###############################################################################

### Empty params. Expect 200 with the DEFAULTS applied, not a 422.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=&sort=&order=
Authorization: Bearer {{token}}

### Whitespace-only search. Expect 200 and the full list, not zero rows.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=%20%20%20
Authorization: Bearer {{token}}

### Unknown sort column. Expect 422.
# This is a security test, not a validation nicety. Without the enum, `sort`
# is interpolated into an orderBy and the caller picks any column on the table.
GET {{baseUrl}}/trips/{{tripId}}/expenses?sort=amountCents
Authorization: Bearer {{token}}

### Unknown order direction. Expect 422.
GET {{baseUrl}}/trips/{{tripId}}/expenses?order=sideways
Authorization: Bearer {{token}}

### Over-long search term. Expect 422 naming the `search` field.
GET {{baseUrl}}/trips/{{tripId}}/expenses?search=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh
Authorization: Bearer {{token}}

### Unknown param. Expect 200 - Zod strips it, it is not an error.
# A stale bookmark carrying ?page=2 should still return a list.
GET {{baseUrl}}/trips/{{tripId}}/expenses?page=2
Authorization: Bearer {{token}}


###############################################################################
# 3. DETAIL - happy path
###############################################################################

### One expense. Expect 200 and { "expense": { ... } }.
#
# Check by hand, every time:
#   - participants[].shareCents SUM TO EXACTLY amountCents
#   - every participant has user { id, displayName }
#   - activity and reservation are null, or at most ONE of them is set
#   - expenseDate is a date, and description may be null
#
# The sum is the one that matters. If the shares do not add up, the balances
# feature built on top of this will never reconcile, and the cause will be
# three PRs behind you by the time anyone notices.
GET {{baseUrl}}/trips/{{tripId}}/expenses/{{expenseId}}
Authorization: Bearer {{token}}


###############################################################################
# 4. DETAIL - scoping and missing records
#
# THE MOST IMPORTANT SECTION IN THIS FILE.
#
# requireTripRole() proves the caller is a member of the trip named in the
# URL. It does NOT prove the expense in the URL belongs to that trip. If the
# controller looks the expense up by its id alone, any member of any trip can
# read any expense in the database by pairing their own tripId with someone
# else's expenseId.
###############################################################################

### An expense id that does not exist. Expect 404, NOT 500.
# A 500 here means the controller used findUniqueOrThrow: its P2025 reaches
# the error handler, which only knows how to turn Zod errors into 422s.
GET {{baseUrl}}/trips/{{tripId}}/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### A malformed expense id. Expect 404.
GET {{baseUrl}}/trips/{{tripId}}/expenses/not-a-real-id
Authorization: Bearer {{token}}

### >>> A REAL expense, from a trip you are NOT a member of, requested
### >>> through a trip you ARE a member of. Expect 404.
#
# If this returns 200 with the expense body, the endpoint leaks every expense
# in the database and the PR must not be merged. The fix is both ids in the
# where clause:  findFirst({ where: { id: expenseId, tripId } })
GET {{baseUrl}}/trips/{{tripId}}/expenses/{{otherTripExpenseId}}
Authorization: Bearer {{token}}

### The same expense through its OWN trip, which you are not in. Expect 404.
# requireTripRole() stops this one before the controller runs. 404 rather
# than 403 is deliberate - a 403 would confirm the trip exists.
GET {{baseUrl}}/trips/{{otherTripId}}/expenses/{{otherTripExpenseId}}
Authorization: Bearer {{token}}

### Listing expenses on a trip you are not a member of. Expect 404.
GET {{baseUrl}}/trips/{{otherTripId}}/expenses
Authorization: Bearer {{token}}

###############################################################################
# 5. CREATE - happy path
#
# After every create, check the response by hand:
#   - participants[].shareCents SUM TO EXACTLY amountCents
#   - amountCents came back as an integer
#   - participants[].user has both id and displayName
###############################################################################

### Three-way split of $62.00. Expect 201.
#
# The shares MUST be 2067, 2067, 2066 - in that order, summing to 6200.
# If you see 2066.67, or three 2067s summing to 6201, the split is rounding
# instead of distributing the remainder and every balance built on it will
# be wrong by cents that nobody can trace.
# @name createdExpense
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Gas",
  "description": "Fill-up on the drive down",
  "amountCents": 6200,
  "expenseDate": "2026-11-12",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"]
}

###
@newExpenseId = {{createdExpense.response.body.expense.id}}

### Minimal body - no description. Expect 201, description null.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Parking",
  "amountCents": 1500,
  "expenseDate": "2026-11-13",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"]
}

### A payer who is NOT a participant. Expect 201.
# Paying for a meal you did not eat is legitimate, and it is exactly the
# imbalance that settlement exists to resolve. Do not "fix" this.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Treated the group",
  "amountCents": 4500,
  "expenseDate": "2026-11-14",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"]
}

### An amount that does not divide evenly. Expect 201.
# 1 cent between N people: the first person pays it, everyone else pays 0.
# Odd-looking, arithmetically correct, and the sum is still exact.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Rounding edge case",
  "amountCents": 1,
  "expenseDate": "2026-11-14",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"]
}

### An expense dated before the trip starts. Expect 201.
# Deliberately allowed: a flight booked months ahead is a real expense on a
# real date.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Flights booked early",
  "amountCents": 48000,
  "expenseDate": "2026-08-01",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"]
}


###############################################################################
# 6. CREATE - validation
#
# Every one of these must be a 422 with error.details naming the field. If any
# returns 201, the bad value reached the database.
###############################################################################

### Missing title. Expect 422.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Whitespace-only title. Expect 422 - trim runs before min(1).
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "   ", "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### >>> DOLLARS INSTEAD OF CENTS. Expect 422.
# The single most likely client bug in this whole module. 62.50 must never
# reach the database - it would store 62 cents and nothing would flag it.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Dinner", "amountCents": 62.50, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Amount as a string. Expect 422 - no coercion on purpose.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Dinner", "amountCents": "6200", "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Zero amount. Expect 422.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Free", "amountCents": 0, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Negative amount. Expect 422.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Refund", "amountCents": -500, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Amount beyond a Postgres Int. Expect 422, NOT 500.
# Without the max() bound Postgres raises an out-of-range error and this
# surfaces as a server crash instead of a field-level message.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Too big", "amountCents": 2147483648, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### A timestamp where a date belongs. Expect 422.
# @db.Date stores a day, not an instant. Accepting a timestamp is how dates
# land a day early for anyone west of Greenwich.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Dinner", "amountCents": 1000, "expenseDate": "2026-11-12T00:00:00.000Z", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### Empty participant list. Expect 422.
# splitEqually would divide by zero.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Nobody", "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": [] }

### Duplicate participant. Expect 422, NOT 500.
# A 500 means the duplicate reached Prisma and tripped
# @@unique([expenseId, userId]) as a P2002.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Twice", "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}", "{{memberId}}"] }

### Client-supplied shares. Expect 201, and the shares IGNORED.
# The server computes the split. Confirm the response shares are the real
# even split, not the 999999 sent here - Zod strips unknown keys.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Nice try",
  "amountCents": 3000,
  "expenseDate": "2026-11-12",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}"],
  "shares": [{ "userId": "{{memberId}}", "shareCents": 999999 }]
}


###############################################################################
# 6b. CREATE - membership scoping
#
# THE SECURITY SECTION FOR THIS PR, and the direct sequel to PR 1's.
#
# requireTripRole() proved the CALLER belongs to this trip. It says nothing
# about the people the caller just named as payer and participants. Without
# the membership check, any member can attach a stranger to an expense -
# putting them into this trip's balances and exposing their display name
# through the detail endpoint.
###############################################################################

### >>> A participant who is NOT a member of this trip. Expect 400.
# A 201 here means the endpoint will attach any user in the database to this
# trip's finances, and the PR must not be merged.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Stranger",
  "amountCents": 1000,
  "expenseDate": "2026-11-12",
  "paidById": "{{memberId}}",
  "participantIds": ["{{memberId}}", "{{outsiderId}}"]
}

### >>> A payer who is NOT a member of this trip. Expect 400.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Stranger paid",
  "amountCents": 1000,
  "expenseDate": "2026-11-12",
  "paidById": "{{outsiderId}}",
  "participantIds": ["{{memberId}}"]
}

### A participant id that does not exist at all. Expect 400, NOT 500.
# A 500 means it reached Prisma and failed the foreign key.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Ghost",
  "amountCents": 1000,
  "expenseDate": "2026-11-12",
  "paidById": "{{memberId}}",
  "participantIds": ["00000000-0000-7000-8000-000000000000"]
}

### Creating on a trip you are not a member of. Expect 404.
POST {{baseUrl}}/trips/{{otherTripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Not mine", "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }

### No auth. Expect 401.
POST {{baseUrl}}/trips/{{tripId}}/expenses
Content-Type: application/json

{ "title": "Anonymous", "amountCents": 1000, "expenseDate": "2026-11-12", "paidById": "{{memberId}}", "participantIds": ["{{memberId}}"] }


###############################################################################
# 7. UPDATE
#
# The re-split is what this section exists to prove. After EVERY patch below,
# check that participants[].shareCents still sums to amountCents. An update
# that changes the money without rebuilding the shares leaves a row that
# looks perfectly fine and quietly breaks every balance derived from it.
###############################################################################

### Title only. Expect 200, shares UNCHANGED.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Gas and snacks" }

### >>> Amount only. Expect 200 and a RE-SPLIT against the stored participants.
# Change 6200 to 7500 and the shares must become 2500/2500/2500 for three
# people - summing to 7500, not still summing to 6200.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "amountCents": 7500 }

### >>> Participants only. Expect 200 and a RE-SPLIT against the stored amount.
# Dropping to fewer people must redistribute the SAME total between them.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "participantIds": ["{{memberId}}"] }

### Both at once. Expect 200, shares sum to the new amount.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "amountCents": 10000, "participantIds": ["{{memberId}}"] }

### Clearing the description with null. Expect 200, description null.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "description": null }

### Changing the payer. Expect 200.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "paidById": "{{memberId}}" }

### Empty body. Expect 422.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Fractional amount. Expect 422 - every base rule survives .partial().
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "amountCents": 75.50 }

### Duplicate participants. Expect 422.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "participantIds": ["{{memberId}}", "{{memberId}}"] }

### >>> Adding a non-member. Expect 400.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "participantIds": ["{{memberId}}", "{{outsiderId}}"] }

### An expense id that does not exist. Expect 404, NOT 500.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/00000000-0000-7000-8000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Ghost" }

### >>> An expense belonging to a trip you are not in. Expect 404.
# Same leak as PR 1, on the write side: without tripId in the where clause
# this edits someone else's expense.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{otherTripExpenseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Should not be editable" }

### No auth. Expect 401.
PATCH {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Content-Type: application/json

{ "title": "Anonymous" }


###############################################################################
# 7b. DELETE
###############################################################################

### Delete the expense created above. Expect 204 with an empty body.
DELETE {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}

### >>> Delete the SAME expense again. Expect 404, NOT 500.
# This is the bug `delete` introduces and `deleteMany` fixes. Prisma's delete
# throws P2025 when nothing matches, and the error handler only knows how to
# turn Zod errors into 422s - so a double-click on a delete button reads as a
# server crash.
DELETE {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}

### An id that never existed. Expect 404, NOT 500.
DELETE {{baseUrl}}/trips/{{tripId}}/expenses/00000000-0000-7000-8000-000000000000
Authorization: Bearer {{token}}

### >>> An expense belonging to a trip you are not in. Expect 404.
# A 204 here means you just deleted someone else's expense.
DELETE {{baseUrl}}/trips/{{tripId}}/expenses/{{otherTripExpenseId}}
Authorization: Bearer {{token}}

### Confirm it is really gone. Expect 404.
GET {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}
Authorization: Bearer {{token}}

### No auth. Expect 401.
DELETE {{baseUrl}}/trips/{{tripId}}/expenses/{{newExpenseId}}


###############################################################################
# 8. AUTHENTICATION
###############################################################################

### No Authorization header. Expect 401.
GET {{baseUrl}}/trips/{{tripId}}/expenses

### Malformed token. Expect 401.
GET {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: Bearer not.a.real.token

### No bearer scheme. Expect 401.
GET {{baseUrl}}/trips/{{tripId}}/expenses
Authorization: {{token}}

### No auth on the detail route either. Expect 401, not 404.
# Order matters: the auth check must run before anything looks at ids.
GET {{baseUrl}}/trips/{{tripId}}/expenses/{{expenseId}}
